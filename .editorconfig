root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,md,mjs,css,html}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120
ktlint_function_signature_body_expression_wrapping = multiline
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 3

# Kotest specs are written as class X : FunSpec({ ... }), which this rule would break over two lines.
[**/src/test/**/*.kt]
ktlint_standard_class-signature = disabled
